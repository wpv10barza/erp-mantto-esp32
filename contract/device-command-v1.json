{
  "protocol_version": "1.1",
  "transport": "HTTPS to Databricks Apps",
  "platform_authentication": {
    "scheme": "OAuth 2.0 Bearer",
    "mode": "service-principal M2M",
    "token_endpoint": "<workspace>/oidc/v1/token",
    "token_lifetime_seconds": 3600,
    "refresh_before_expiry_seconds": 300
  },
  "application_authentication_header": "X-3C-Device-Token",
  "health_path": "/api/device/v1/health",
  "command_path": "/api/device/v1/commands",
  "status_path": "/api/device/v1/commands/{command_id}",
  "request": {
    "required": ["device_id", "request_id", "text"],
    "device_id_max_length": 64,
    "request_id_max_length": 96,
    "text_max_length": 1000
  },
  "accepted_status_codes": [200, 202],
  "accepted_state": "pending_confirmation",
  "device_status_polling": true,
  "device_status_authentication": true,
  "direct_sheet_write": false,
  "requires_human_confirmation": true,
  "backend": {
    "production_mode": "configured_https_url",
    "production_provider": "Databricks Apps",
    "local_fallback": "mDNS _3c._tcp only when ASSISTANT_BASE_URL_VALUE is empty"
  }
}

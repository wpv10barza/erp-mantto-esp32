# Copy to src/secrets.yaml for a local device installation.
# Do not commit src/secrets.yaml; it is ignored by .gitignore.

wifi_ssid: "YOUR_WIFI_SSID"
wifi_password: "YOUR_WIFI_PASSWORD"

# ESPHome API encryption key: 32 random bytes encoded as base64.
display_key: "GENERATE_A_VALID_32_BYTE_BASE64_KEY"

# OTA password used by ESPHome.
display_ota: "CHANGE_THIS_OTA_PASSWORD"
